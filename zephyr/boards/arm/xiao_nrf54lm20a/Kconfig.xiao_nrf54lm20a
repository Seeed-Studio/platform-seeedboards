config BOARD_XIAO_NRF54LM20A
	select SOC_NRF54LM20A_CPUAPP if BOARD_XIAO_NRF54LM20A_NRF54LM20A_CPUAPP
	select SOC_NRF54LM20A_CPUFLPR if BOARD_XIAO_NRF54LM20A_NRF54LM20A_CPUFLPR

if BOARD_XIAO_NRF54LM20A_NRF54LM20A_CPUAPP

if !MCUBOOT

# The nPM1300 charger raises the VBUS current limit from the 100 mA power-on
# default to vbus-limit-microamp during its init. LDO1's soft-start inrush
# exceeds 100 mA, so the nPM13xx regulator init must run after the charger
# (SENSOR_INIT_PRIORITY, default 90) or the PMIC trips overcurrent and the
# board power-cycles in a loop. SENSOR must also be on for the charger to be
# compiled in at all (drivers/sensor/Kconfig gates it behind `if SENSOR`).
config SENSOR
	bool
	default y

config REGULATOR
	bool
	default y

endif # !MCUBOOT

if REGULATOR_NPM13XX

# Both must stay after the charger (90) and INIT must stay greater than
# COMMON, hence the 91/92 pair.
config REGULATOR_NPM13XX_COMMON_INIT_PRIORITY
	int
	default 91

config REGULATOR_NPM13XX_INIT_PRIORITY
	int
	default 92

endif # REGULATOR_NPM13XX

endif # BOARD_XIAO_NRF54LM20A_NRF54LM20A_CPUAPP
