# Enable UART driver
CONFIG_SERIAL=y

# Console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Enable GPIO
CONFIG_GPIO=y
CONFIG_GPIO_HOGS=y

# ARM Cortex-M33 features
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# UF2 bootloader chain-load support
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_INIT_ARCH_HW_AT_BOOT=y

# USB device stack (new stack / UDC). The STM32C5 USB DRD FS peripheral is
# driven by the standard udc_stm32.c driver (HAL2-patched, carried under
# zephyr/overrides/ — upstream Zephyr only gained STM32C5 USB support in
# PR #105957, post-4.4.0). The 1200-bps UF2 trigger rides on top of this.
CONFIG_USB_DEVICE_STACK_NEXT=y

# CDC ACM class (virtual serial port) + line control (baudrate read, used by
# the 1200-bps UF2 trigger). The uf2_dfu_reset module brings up USB and
# registers the line-coding callback automatically at boot.
CONFIG_USBD_CDC_ACM_CLASS=y
CONFIG_UART_LINE_CTRL=y
