{
  "name": "seeed",
  "title": "Seeed Studio Multi-Chip Platform",
  "description": "One platform address, every chip family plugged in as data + classes",
  "homepage": "https://github.com/example/platform-seeed",
  "license": "Apache-2.0",
  "keywords": [
    "dev-platform",
    "multi-chip"
  ],
  "engines": {
    "platformio": ">=6.1.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Seeed-Studio/platform-seeed.git"
  },
  "version": "0.0.1",
  "frameworks": {
    "arduino": {
      "script": "builder/frameworks/arduino.py"
    }
  },
  "packages": {
    "toolchain-gccarmnoneeabi": {
      "type": "toolchain",
      "optional": true,
      "owner": "platformio",
      "version": ">=1.70201.0,<1.130000.0",
      "optionalVersions": [
        "~1.70201.0",
        "~1.80201.0",
        "~1.120301.0"
      ]
    },
    "framework-arduino-samd-seeed": {
      "type": "framework",
      "optional": true,
      "owner": "platformio",
      "version": "~1.8.5"
    },
    "framework-cmsis": {
      "type": "framework",
      "optional": true,
      "owner": "platformio",
      "version": "~2.50700.0",
      "optionalVersions": [
        "~2.50400.0"
      ]
    },
    "framework-cmsis-atmel": {
      "type": "framework",
      "optional": true,
      "owner": "platformio",
      "version": "~1.2.2",
      "optionalVersions": [
        "~1.1.0"
      ]
    },
    "tool-bossac": {
      "type": "uploader",
      "optional": true,
      "owner": "platformio",
      "version": "~1.10901.0"
    },
    "tool-openocd": {
      "type": "uploader",
      "optional": true,
      "owner": "platformio",
      "version": "~3.1200.0"
    },
    "tool-jlink": {
      "optional": true,
      "owner": "platformio",
      "version": "^1.81206.0"
    }
  }
}
