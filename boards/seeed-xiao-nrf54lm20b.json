{
    "build": {
      "cpu": "cortex-m33",
      "f_cpu": "128000000L",
      "mcu": "nrf54lm20a",
      "zephyr": {
        "variant": "xiao_nrf54lm20b/nrf54lm20b/cpuapp",
        "bootloader": {
          "header_len": "0x800",
          "flash_alignment": "16",
          "slot_size": "0x1BE000",
          "app_version": "0.0.1",
          "signature_key_file": "root-ed25519.pem",
          "pure": "true"
        }
      }
    },
    "connectivity": [
      "bluetooth"
    ],
    "debug": {
      "default_tools": [
        "cmsis-dap"
      ],
      "jlink_device": "nRF54LM20A_M33",
      "openocd_target": "$PROJECT_CORE_DIR/platforms/\"$PIOPLATFORM\"/builder/board_build/nrf/nrf54lm20a.cfg",
      "svd_path": "nrf54lm20a.svd"
    },
    "frameworks": [
      "zephyr"
    ],
    "name": "Seeed Studio XIAO nRF54LM20B",
    "upload": {
      "maximum_ram_size": 524288,
      "maximum_size": 2084864,
      "protocol": "nrfutil-mcumgr",
      "pyocd_target": "nrf54lm20a",
      "pyocd_frequency": 4000000,
      "protocols": [
        "nrfutil-mcumgr",
        "cmsis-dap",
        "jlink",
        "pyocd",
        "probe-rs"
      ]
    },
    "url": "https://wiki.seeedstudio.com/XIAO_BLE",
    "vendor": "Seeed Studio"
  }
